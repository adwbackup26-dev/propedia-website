# ── Propedia local development environment ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore — it will NEVER be pushed to GitHub.
#
# Run locally with: npx vercel dev

# TRREB PropTx API tokens (from your PropTx dashboard after broker approval)
TRREB_IDX_TOKEN=paste_your_idx_token_here
TRREB_VOW_TOKEN=paste_your_vow_token_here
TRREB_DLA_TOKEN=paste_your_dla_token_here

# Airtable (from airtable.com → Developer Hub → Personal access tokens)
AIRTABLE_API_KEY=paste_your_airtable_token_here
AIRTABLE_BASE_ID=paste_your_base_id_here

# Chat mode — keep as "passive" until Phase 2 is ready
VITE_CHAT_MODE=passive
